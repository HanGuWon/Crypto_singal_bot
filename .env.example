LIVE_TRADING_ENABLED=false
PRIVATE_API_ENABLED=false
REQUIRE_MANUAL_APPROVAL=true
NOTIFICATIONS_ENABLED=false
TELEGRAM_ENABLED=false
DISCORD_WEBHOOK_ENABLED=false

APP_ENV=local
LOG_LEVEL=INFO
DATABASE_PATH=data/crypto_signal_bot.sqlite
DISPLAY_TIMEZONE=Asia/Seoul

UPBIT_BASE_URL=https://api.upbit.com
BINANCE_BASE_URL=https://data-api.binance.vision
DEFAULT_REQUEST_TIMEOUT_SECONDS=10
MAX_SYMBOLS_PER_COLLECT=20
MAX_ORDERBOOK_SYMBOLS_PER_COLLECT=10
ORDERBOOK_DEPTH_LIMIT=20
POLLING_INTERVAL_SECONDS=300

MIN_QUOTE_VOLUME_UPBIT_KRW=2000000000
MIN_QUOTE_VOLUME_BINANCE_USDT=2000000
MAX_SPREAD_BPS=30
MAX_STALENESS_SECONDS=1200
MIN_HISTORY_BARS=80
SYMBOL_QUARANTINE_MINUTES=120

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_DISABLE_NOTIFICATION=false

DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Crypto Signal Research Bot
DISCORD_THREAD_ID=
DISCORD_ALLOW_MENTIONS=false

ALERT_SCORE_THRESHOLD=80
ALERT_EXIT_THRESHOLD=65
ALERT_SCORE_DELTA_THRESHOLD=15
ALERT_COOLDOWN_MINUTES=60
ALERT_TOP_N=10
ALERT_DIGEST_ENABLED=false
ALERT_DIGEST_INTERVAL_MINUTES=60
ALERT_GLOBAL_MAX_PER_MINUTE=10
ALERT_PER_SYMBOL_MAX_PER_HOUR=1
ALERT_SAFETY_GLOBAL_MAX_PER_MINUTE=5
ALERT_SAFETY_PER_SYMBOL_MAX_PER_HOUR=3
