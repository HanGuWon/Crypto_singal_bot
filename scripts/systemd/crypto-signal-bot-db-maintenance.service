[Unit]
Description=Prune and vacuum Crypto Signal Bot SQLite database

[Service]
Type=oneshot
User=crypto-signal-bot
WorkingDirectory=/opt/crypto_signal_bot
EnvironmentFile=/opt/crypto_signal_bot/.env
ExecStart=/opt/crypto_signal_bot/.venv/bin/python -m crypto_signal_bot.cli db prune-retention --profile configs/gcp_free_tier.yaml --execute --vacuum
