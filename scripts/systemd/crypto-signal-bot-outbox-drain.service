[Unit]
Description=Crypto Signal Bot notification outbox drain
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=crypto-signal-bot
WorkingDirectory=/opt/crypto_signal_bot
EnvironmentFile=/opt/crypto_signal_bot/.env
ExecStart=/bin/sh -lc 'if [ "$NOTIFICATIONS_ENABLED" != "true" ]; then echo "Notifications disabled; skipping outbox drain."; exit 0; fi; exec /opt/crypto_signal_bot/.venv/bin/python -m crypto_signal_bot.cli notifications outbox drain --max 10'
