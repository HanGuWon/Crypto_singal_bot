[Unit]
Description=Crypto Signal Bot research ranking
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=crypto-signal-bot
WorkingDirectory=/opt/crypto_signal_bot
EnvironmentFile=/opt/crypto_signal_bot/.env
ExecStart=/opt/crypto_signal_bot/.venv/bin/python -m crypto_signal_bot.cli rank --exchange binance --quote USDT --interval 5m --top 20 --format json --include-entry-timing --save-run
